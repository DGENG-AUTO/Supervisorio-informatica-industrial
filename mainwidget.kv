#:kivy 2.0.0
#TUDO VISTO
<MainWidget>:
    BoxLayout:
        orientation: 'vertical'
        md_bg_color: 0,8588235294117647, 0,8588235294117647, 0,8588235294117647
        #BARRA SUPERIOR
        MDTopAppBar:
            orientation: 'horizontal'
            elevation: 2
            BoxLayout:
                orientation: 'vertical'
                size_hint: None, None
                size: "120dp", "50dp"
                spacing: "4dp"
                Label:
                    id: label_con
                    text: "[b]DESCONECTADO[/b]"
                    markup: True
                    color: (1, 0, 0, 1)
                    font_size: "12sp"
                    halign: "center"
                    size_hint_y: 0.4
                Image:
                    id: img_con
                    source: "img/con_off.png"
                    allow_stretch: True
                    keep_ratio: True
                    size_hint: (1, 0.6)                                

        FloatLayout:
            size_hint: (1, 1)
            Image:
                # IMAGEM DE FUNDO DO SUPERVISÓRIO (DUAS CAIXA D'ÁGUA)
                source: "img/base_supervisorio.png"
                allow_stretch: True
                keep_ratio: False
                size_hint: (1, 1)
                pos_hint: {"center_x": 0.5, "center_y": 0.5}

            #BARRA DE PROGRESSO DA CAIXA D'ÁGUA INFERIOR
            BoxLayout:                 
                orientation: 'vertical'
                size_hint: (0.018, 0.295)
                pos_hint: {'x': 0.255, 'y': 0.27}
                padding: "5dp"
                canvas.before:
                    Color:
                        rgba: (0.4, 0.4, 0.4, 0.5)
                    Rectangle:
                        pos: self.pos
                        size: self.size
                MDProgressBar:
                    id: nivel_agua_inferior
                    orientation: 'vertical'
                    value: 2  # VALOR DEVE SER MODIFICADO EM TEMPO REAL(NÃO ESQUEÇA!)
                    max: 100
                    color: (0, 0, 1, 1)
                    size_hint: (1, 1)

            BoxLayout:
                # BARRA DE PROGRESSO DA CAIXA D'ÁGUA SUPERIOR
                orientation: 'vertical'
                size_hint: (0.018, 0.295)
                pos_hint: {'x': 0.745, 'y': 0.497}
                padding: "5dp"
                canvas.before:
                    Color:
                        rgba: (0.4, 0.4, 0.4, 1)
                    Rectangle:
                        pos: self.pos
                        size: self.size
                MDProgressBar:
                    id: nivel_agua_superior
                    orientation: 'vertical'
                    value: 80  # VALOR DEVE SER MODIFICADO EM TEMPO REAL(NÃO ESQUEÇA!)
                    max: 100
                    color: (0, 0, 1, 1)
                    size_hint: (1, 1)

            Button:
                id: img_motor 
                background_normal:"img/Motor_off (1).png" 
                keep_ratio: False
                size_hint: (0.08,0.15)
                pos_hint: {"x": 0.546, "y": 0.259}
                on_release: root.acionamento_imagem()
            
            Image:
                id: valvula_inf 
                source: "img/valvula off.png"  
                keep_ratio: False
                size_hint: (0.06,0.06)
                pos_hint: {"x": 0.35, "y": 0.305}

            Image:
                id: valvula_sup
                source: "img/valvula off.png"  
                keep_ratio: False
                size_hint: (0.06,0.06)
                pos_hint: {"x": 0.60, "y": 0.855}
            
            Image:
                id: fit
                source: "img/FIT.png"  
                keep_ratio: False
                size_hint: (0.07,0.07)
                pos_hint: {"x": 0.586, "y": 0.65}
            
            Image:
                id: pit
                source: "img/PIT.png"  
                keep_ratio: False
                size_hint: (0.06,0.06)
                pos_hint: {"x": 0.524, "y": 0.54}

            # CARDS DE DADOS
            FloatLayout:
            #CARD NIVEL
                BoxLayout:
                    orientation:'vertical'
                    pos_hint: {'x': 0.775, 'y': 0.68}
                    size_hint: (0.3, 0.1)
                    spacing: dp(25)
                    Label:
                        id: lit01_label
                        text: "Nível: %"
                        halign: "left"
                        markup: True                       
                        color: (0, 0, 1, 1)  
                        font_size: "20sp"
                        text_size: self.width, None
                        height: self.texture_size[1]
            # CARD TEMPERATURA DO MOTOR
                BoxLayout:
                    orientation: 'vertical'
                    pos_hint: {'x': 0.70, 'y': 0.18}
                    size_hint: (0.15, 0.2)
                    padding: dp(10)
                    spacing: dp(10)

                    canvas.before:
                        Color:
                            rgba: 0, 0, 1, 0.3  
                        Line:
                            width: 1.5
                            rectangle: (self.x, self.y, self.width, self.height)

                    Label:
                        text: "Temperatura do Motor:"
                        halign: "left"
                        color: (0, 0, 1, 1)
                        font_size: "18sp"
                        bold: True
                        text_size: self.width, None

                    Label:
                        id: temp_r
                        text: "R: 242.0 °C"
                        halign: "left"
                        color: (0, 0, 1, 1)
                        font_size: "16sp"
                        text_size: self.width, None

                    Label:
                        id: temp_s
                        text: "S: 242.0 °C"
                        halign: "left"
                        color: (0, 0, 1, 1)
                        font_size: "16sp"
                        text_size: self.width, None

                    Label:
                        id: temp_t
                        text: "T: 240.0 °C"
                        halign: "left"
                        color: (0, 0, 1, 1)
                        font_size: "16sp"
                        text_size: self.width, None

                    Label:
                        id: temp_carc
                        text: "Carcaça: 243.0 °C"
                        halign: "left"
                        color: (0, 0, 1, 1)
                        font_size: "16sp"
                        text_size: self.width, None
                        
            #CARD TIPO DE MOTOR
                BoxLayout:
                    orientation:'vertical'
                    pos_hint: {'x': 0.626, 'y': 0.18}
                    size_hint: (0.07, 0.2)
                    padding: dp(5)
                    spacing: dp(5)

                    canvas.before:
                        Color:
                            rgba: 0, 0, 1, 0.3  
                        Line:
                            width: 1.5
                            rectangle: (self.x, self.y, self.width, self.height)

                    Label:
                        id: how_motor
                        text: "ESTADO"
                        halign: "left"
                        color: (0, 0, 1, 1)
                        font_size: "18sp"
                        bold: True
                        text_size: self.width, None
                    Label:
                        id: tipo_motor
                        text: "tipo motor"
                        halign: "left"
                        color: (0, 0, 1, 1)
                        font_size: "16sp"
                        text_size: self.width, None

                    Label:
                        id: rpm
                        text: "RPM"
                        halign: "left"
                        color: (0, 0, 1, 1)
                        font_size: "16sp"
                        text_size: self.width, None

                    Label:
                        id: torque
                        text: "Torque"
                        halign: "left"
                        color: (0, 0, 1, 1)
                        font_size: "16sp"
                        text_size: self.width, None
                
                    
            #CARD VAZÃO
                BoxLayout:
                    orientation:'vertical'
                    pos_hint: {'x': 0.60, 'y': 0.677}
                    size_hint: (0.3, 0.1)
                    spacing: dp(-10)
                    Label:
                        id: fit_01
                        text: "fit"
                        halign: "left"
                        markup: True                       
                        color: (0, 0, 1, 1)  
                        font_size: "20sp"
                        text_size: self.width, None
                        height: self.texture_size[1]
            #CARD PRESSÃO
                BoxLayout:
                    orientation:'vertical'
                    pos_hint: {"x": 0.50, "y": 0.57}
                    size_hint: (0.2, 0.1)
                    spacing: dp(-10)
                    Label:
                        id: pit_01
                        text: "pit"
                        halign: "left"
                        markup: True                      
                        color: (0, 0, 1, 1)  
                        font_size: "20sp"
                        text_size: self.width, None
                        height: self.texture_size[1]                 
            #AVISO
                BoxLayout:
                    orientation:'vertical'
                    pos_hint: {'x': 0.78, 'y': 0.75}
                    size_hint: (0.3, 0.1)
                    spacing: dp(-10)
                    Label:
                        id: reserva_sup
                        text: ""
                        halign: "left"
                        markup: True                       
                        color: (1, 0, 0, 1)  
                        font_size: "20sp"
                        text_size: self.width, None
                        height: self.texture_size[1]
            #FIM CARDS DE DADOS

            # BOTÕES DE COMANDO PARTE INFERIOR
            BoxLayout:
                orientation: 'horizontal'
                size_hint: (1, 0.1)  
                pos_hint: {'center_x': 0.5, 'y': 0} 
                padding: "5dp"
                spacing: "5dp"

            #BOTÃO DE CONEXÃO MODBUS
                MDRaisedButton:
                    size_hint: (0.05, 1)
                    size: "100dp", "30dp"
                    id: bt_conection
                    on_release: root._j_modbusPopup.open()
                    MDBoxLayout:
                        orientation: 'horizontal'
                        padding: "5dp"
                        spacing: "5dp"
                        IconLeftWidget:
                            icon: "connection"  
                            size_hint: (0.4, 1)
                        MDLabel:
                            text: "CONEXÃO MODBUS"
                            bold: True
                            halign: "center"
                            size_hint: (0.6, 1)

            #BOTÃO TEMPO DE VARREDURA
                MDRaisedButton:
                    size_hint: (0.05, 1)
                    size: "100dp", "30dp"
                    id: bt_time
                    on_release: root._j_scanPopup.open()
                    MDBoxLayout:
                        orientation: 'horizontal'
                        padding: "5dp"
                        spacing: "5dp"
                        IconLeftWidget:
                            icon: "clock"  
                            size_hint: (0.4, 1)
                        MDLabel:
                            text: 'SCAN TIME'
                            bold: True
                            halign: "center"
                            size_hint: (0.6, 1) 

            #BOTÃO ATUAÇÃO
                MDRaisedButton:
                    size_hint: (0.05, 1)
                    size: "100dp", "30dp"
                    id: botao_comando
                    on_release: root._j_atuacao.open()
                    MDBoxLayout:
                        orientation: 'horizontal'
                        padding: "5dp"
                        spacing: "5dp"
                        IconLeftWidget:
                            icon: "engine-outline"  
                            size_hint: (0.4, 1)
                            on_release: root._j_atuacao.open()
                        MDLabel:
                            text: 'ATUAÇÃO'
                            bold: True
                            halign: "center"
                            size_hint: (0.6, 1)

            #BOTÃO MEDIÇÕES
                MDRaisedButton:
                    size_hint: (0.05, 1)
                    size: "100dp", "30dp"
                    id: botao_m_eletrica
                    on_release: root._j_medidas.open()
                    MDBoxLayout:
                        orientation: 'horizontal'
                        padding: "5dp"
                        spacing: "5dp"
                        IconLeftWidget:
                            icon: "ruler-square-compass"  
                            size_hint: (0.4, 1)
                        MDLabel:
                            text: "MEDIÇÕES"
                            bold: True
                            halign: "center"
                            size_hint: (0.6, 1) 

            #BOTÃO GRAFICOS
                MDRaisedButton:
                    size_hint: (0.05, 1)
                    size: "100dp", "30dp"
                    id: botao_temperatura
                    on_release: root._j_graficos.open()
                    MDBoxLayout:
                        orientation: 'horizontal'
                        padding: "5dp"
                        spacing: "5dp"
                        IconLeftWidget:
                            icon: "chart-line"  
                            size_hint: (0.4, 1)
                        MDLabel:
                            text: "GRÁFICOS"
                            bold: True
                            halign: "center"
                            size_hint: (0.6, 1)          
            
            
            #HISTÓRIOC DE DADOS
                MDRaisedButton:
                    size_hint: (0.05, 1)
                    size: "100dp", "30dp"
                    id: bt_data
                    on_release: root._j_histgraph.open()  
                    MDBoxLayout:
                        orientation: 'horizontal'
                        padding: "5dp"
                        spacing: "5dp"
                        IconLeftWidget:
                            icon: "history"  
                            size_hint: (0.4, 1)
                        MDLabel:
                            text: "HISTÓRICO"
                            bold: True
                            halign: "center"
                            size_hint: (0.6, 1)
            #SAIR
                MDRaisedButton:
                    size_hint: (0.05, 1)
                    size: "100dp", "30dp"
                    on_release:
                        on_release: root.desconectar()
                        app.stop()
                    MDBoxLayout:
                        orientation: 'horizontal'
                        padding: "5dp"
                        spacing: "5dp"
                        IconLeftWidget:
                            icon: "logout"  
                            size_hint: (0.4, 1)
                        MDLabel:
                            text: "SAIR"
                            bold: True
                            halign: "center"
                            size_hint: (0.6, 1)