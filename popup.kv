#PARCIALMENTE VISTO 
<Graficos>:
    size_hint: 0.8, 0.80
    auto_dismiss: True
    background_color: 0, 0, 0, 0.3

    FloatLayout:
        orientation: 'vertical'
        MDTopAppBar:
            title: 'Gráficos'
            md_bg_color: .2, .2, .2, 1
            specific_text_color: 1, 1, 1, 1
            right_action_items: [["close", lambda x: root.dismiss()]]
            pos_hint: {'top': 1, 'right': 1}

        TimeSeriesGraph:
            id: graph
            xlabel: 'Horário [s]'
            ylabel: 'Amper [A]'
            background_color: 0.5, 0.5, 0.5, 0.5
            x_ticks_minor: 1
            x_ticks_major: 5
            y_ticks_major: 40
            y_grid_label: True
            x_grid_label: True
            padding: 5
            x_grid: True
            y_grid: True
            xmin: 0
            ymin: 0
            ymax: 200
            size_hint: 0.7, 0.58
            pos_hint: {'center_x': 0.35, 'center_y': 0.6}
            current_visible: current_checkbox.active
            voltage_visible: voltage_checkbox.active
            power_visible: power_checkbox.active
            thd_visible: thd_checkbox.active
            temp_visible: temp_checkbox.active

        BoxLayout:
            id: legend
            orientation: 'vertical'
            size_hint: 0.2, 0.58
            pos_hint: {'right': 0.95, 'center_y': 0.6}
            canvas.before:
                Color:
                    rgba: 0.2, 0.2, 0.2, 0.5
                Rectangle:
                    pos: self.pos
                    size: self.size

        BoxLayout:
            orientation: 'vertical'
            size_hint: 0.8, 0.2
            pos_hint: {'center_x': 0.5, 'center_y': 0.2}
            spacing: 10

            BoxLayout:
                orientation: 'horizontal'
                size_hint: 1, 0.6
                Label:
                    size_hint: 0.3, 1
                    text: 'Número de pontos do gráfico'
                LabeledCheckBoxDataGraph:
                    id: mp20
                    on_kv_post:
                        self.ids.label.text = '20'
                        self.ids.checkbox.group = 'cd_group'
                        self.ids.checkbox.active = True
                        self.ids.checkbox.md_bg_color = [0.2, 0.2, 0.2, 1]
                LabeledCheckBoxDataGraph:
                    id: mp50
                    on_kv_post:
                        self.ids.label.text = '50'
                        self.ids.checkbox.group = 'cd_group'
                        self.ids.checkbox.md_bg_color = [0.2, 0.2, 0.2, 1]
                LabeledCheckBoxDataGraph:
                    id: mp100
                    on_kv_post:
                        self.ids.label.text = '100'
                        self.ids.checkbox.group = 'cd_group'
                        self.ids.checkbox.md_bg_color = [0.2, 0.2, 0.2, 1]

            BoxLayout:
                orientation: 'horizontal'
                size_hint: 1, 0.4
                Button:
                    text: "Fechar"
                    size_hint: 0.2, 1
                    md_bg_color: 0.7, 0.8, 1, 1
                    text_color: 0, 0, 0, 1
                    on_release: root.dismiss()
                BoxLayout:
                    orientation: 'horizontal'
                    CheckBox:
                        id: current_checkbox
                        group: 'graph_type'
                        active: True
                        md_bg_color: [0.2, 0.2, 0.2, 1]
                        on_active: 
                            app.root._j_graficos.ids.graph.current_visible = self.active
                            app.root._j_graficos.update_plot_visibility()
                    Label:
                        text: 'Corrente'
                    CheckBox:
                        id: voltage_checkbox
                        group: 'graph_type'
                        md_bg_color: [0.2, 0.2, 0.2, 1]
                        on_active: 
                            app.root._j_graficos.ids.graph.voltage_visible = self.active
                            app.root._j_graficos.update_plot_visibility()
                    Label:
                        text: 'Tensão'
                    CheckBox:
                        id: power_checkbox
                        group: 'graph_type'
                        md_bg_color: [0.2, 0.2, 0.2, 1]
                        on_active: 
                            app.root._j_graficos.ids.graph.power_visible = self.active
                            app.root._j_graficos.update_plot_visibility()
                    Label:
                        text: 'Potência'
                    CheckBox:
                        id: thd_checkbox
                        group: 'graph_type'
                        md_bg_color: [0.2, 0.2, 0.2, 1]
                        on_active: 
                            app.root._j_graficos.ids.graph.thd_visible = self.active
                            app.root._j_graficos.update_plot_visibility()
                    Label:
                        text: 'Tensão THD'
                    CheckBox:
                        id: temp_checkbox
                        group: 'graph_type'
                        md_bg_color: [0.2, 0.2, 0.2, 1]
                        on_active: 
                            app.root._j_graficos.ids.graph.temp_visible = self.active
                            app.root._j_graficos.update_plot_visibility()
                    Label:
                        text: 'Temperatura'

<LabeledCheckBoxDataGraph>:
    orientation: 'horizontal'
    size_hint: (0.1, 1)
    CheckBox:
        id: checkbox
        on_active: 
            app.root._j_graficos.ids.graph.setMaxPoints(int(self.parent.ids.label.text), 0) if app.root is not None else None
        md_bg_color: [0.2, 0.2, 0.2, 1]
    Label:
        id: label

<HistGraphPopup>:
    title: "Histórico"
    BoxLayout:
        orientation: 'vertical'
        TimeSeriesGraph:
            id: graph
            xlabel: 'Horário'
            ylabel: 'Temperatura [°C]'
            background_color: 0.5, 0.5, 0.5, 0.5
            x_ticks_minor: 1
            x_ticks_major: 5
            y_ticks_minor: 100
            y_ticks_major: 100
            y_grid_label: True
            x_grid_label: True
            padding: 5
            x_grid: True
            y_grid: True
            xmin: 0
            xmax: 0
            ymin: 0
            ymax: 500
        BoxLayout:
            id: sensores
            orientation: 'horizontal'
            size_hint: (1, 0.1)
        BoxLayout:
            orientation: 'horizontal'
            size_hint: (1, 0.1)
            Label:
                text: 'Timestamp inicial \r\n [size=12] (DD/MM/AAAA HH:MM :SS)[/size]'
                halign: 'center'
                markup: True
            TextInput:
                id: txt_init_time
                size_hint: (1, 0.8)
                halign: 'center'
                valign: 'middle'
                multiline: False
            Label:
                text: 'Timestamp final \r\n [size=12] (DD/MM/AAAA HH:MM :SS)[/size]'
                halign: 'center'
                markup: True
            TextInput:
                id: txt_final_time
                size_hint: (1, 0.8)
                halign: 'center'
                valign: 'middle'
                multiline: False
            Button:
                text: "Atualizar"
                size_hint: (1, 0.8)
                on_release: app.root.read_data(root.ids.txt_init_time.text, root.ids.txt_final_time.text)

<LabeledCheckBoxHistGraph>:
    orientation: 'horizontal'
    size_hint: (0.1, 1)
    CheckBox:
        id: checkbox
        on_active: app.root.update_graph_selection(root.ids.label.text, self.active)
        md_bg_color: [0.2, 0.2, 0.2, 1]
    Label:
        id: label

   
        