#:kivy 2.0.0

<Modbus_Popup>:
    title: "Conexão MODBUS"
    size_hint_x: 0.3
    size_hint_y: 0.25
    height: "180dp"
    auto_dismiss: False
    BoxLayout:
        id: layout1
        orientation: 'vertical'
        padding: "5dp"
        spacing: "5dp"
        MDTextFieldRect:
            id: entrada_ip
            hint_text: "Digite o IP"
            mode: "rectangle"
            size_hint_x: 1
            radius: [15, 15, 15, 15]
            text_color: 0, 0, 1, 0
            text_color: 0, 0, 1, 1
            line_color_normal: 0.6, 0.6, 0.6, 1
            fill_color: 1, 1, 1, 1  
        
        MDTextFieldRect:
            id: entrada_porta
            text: ""
            hint_text: "Digite o número porta"
            mode: "rectangle"
            size_hint_x: 1
            radius: [15, 15, 15, 15]
            text_color: 0, 0, 1, 0
            text_color: 0, 0, 1, 1
            line_color_normal: 0.6, 0.6, 0.6, 1
            fill_color: 1, 1, 1, 1 

        BoxLayout:
            orientation: 'horizontal'
            spacing: "10dp"
            size_hint_y: None
            height: "40dp"

            MDRaisedButton:
                text: "Conectar"
                size_hint_x: 0.5
                md_bg_color: 0.7, 0.8, 1, 1 
                text_color: 0, 0, 0, 1
                on_release:
                    app.root.start_atendimento(entrada_ip.text,int(entrada_porta.text)) 
                    print(app.root.start_atendimento) 
            MDRaisedButton:
                text: "Fechar"
                size_hint_x: 0.5
                on_release: root.dismiss()
                md_bg_color: 0.7, 0.8, 1, 1
                text_color: 0, 0, 0, 1


<Scan_Popup>:
    title: "Configuração do Scan time"
    size_hint_x: 0.4
    size_hint_y: None
    height: "170dp"
    auto_dismiss: False    
    BoxLayout:
        orientation: 'vertical'
        padding: "10dp"
        spacing: "10dp"
        MDTextFieldRect:
            id: entrada_time
            text: ""
            hint_text: "Digite o tempo de varredura [ms]"
            helper_text_mode: "on_focus"
            mode: "rectangle"  
            size_hint_x: 1
            text_color: 0, 0, 1, 1
            line_color_normal: 0.6, 0.6, 0.6, 1
            fill_color: 1, 1, 1, 1
        BoxLayout:
            orientation: 'horizontal'
            spacing: "10dp"
            size_hint_y: None
            height: "40dp"        
            MDRaisedButton:
                text: "Confirmar"
                size_hint_x: 0.5
                on_release: 
                    app.root._scan_time = int(entrada_time.text)
                    #print(app.root._scan_time)
                   
            MDRaisedButton:
                text: "Fechar"
                size_hint_x: 0.5
                on_release: root.dismiss()


<Atuacao>:
    title: "Atuação/controle"
    size_hint_x: 0.47
    size_hint_y: 0.42
    auto_dismiss: True

    BoxLayout:
        orientation: 'horizontal'
        spacing: "10dp"
        padding: "10dp"

        # Coluna 1 - COMANDO BOMBA D'ÁGUA
        MDCard:
            orientation: "vertical"
            padding: "12dp"
            spacing: "10dp"
            size_hint: None, None
            size: "220dp", "260dp"
            md_bg_color: 0.85, 0.85, 0.85, 1  
            radius: [20, 20, 20, 20]  
            elevation: 4  

            Label:
                text: "COMANDO BOMBA D'ÁGUA"
                halign: "center"
                color: 0,0,0

            MDRaisedButton:
                id: bt_liga_motor
                text: "LIGAR MOTOR"
                pos_hint: {"center_x": 0.5}
                size_hint_x: 0.8
                on_release: root.liga_desliga_motor(800)

            MDRaisedButton:
                id: bt_desliga_motor
                text: "DESLIGAR MOTOR"
                pos_hint: {"center_x": 0.5}
                size_hint_x: 0.8

            MDRaisedButton:
                id:bt_reset
                text: "RESET"
                pos_hint: {"center_x": 0.5}
                size_hint_x: 0.8

        # Coluna 2 - TIPO DE PARTIDA
        MDCard:
            orientation: "vertical"
            padding: "12dp"
            spacing: "10dp"
            size_hint: None, None
            size: "220dp", "260dp"
            md_bg_color: 0.85, 0.85, 0.85, 1  
            radius: [20, 20, 20, 20]  
            elevation: 4

            Label:
                text: "SELECIONAR TIPO DE PARTIDA"
                halign: "center"
                color: 0,0,0

            MDRaisedButton:
                id: bt_pt_direta
                text: "TESYS DIRETA"
                pos_hint: {"center_x": 0.5}
                size_hint_x: 0.8

            MDRaisedButton:
                id: bt_pt_inversor
                text: "ATV31 INVERSOR"
                pos_hint: {"center_x": 0.5}
                size_hint_x: 0.8

            MDRaisedButton:
                id: bt_pt_soft
                text: "ATS48 SOFT-START"
                pos_hint: {"center_x": 0.5}
                size_hint_x: 0.8
        
        # Coluna 3 - MUDANÇA DE VELOCIDADE
        MDCard:
            orientation: "vertical"
            padding: "16dp"
            spacing: "12dp"
            size_hint: None, None
            size: "220dp", "260dp"
            md_bg_color: 0.85, 0.85, 0.85, 1
            radius: [20, 20, 20, 20]
            elevation: 4

            Label:
                text: "MUDANÇA DE VELOCIDADE"
                halign: "center"
                color: 0,0,0

            BoxLayout:
                orientation: "horizontal"
                spacing: "12dp"
                size_hint_y: None
                height: "120dp"
                # Slider à esquerda, campos à direita
                MDSlider:
                    id: slider_velocidade
                    min: 0
                    max: 60
                    value: 0
                    orientation: 'vertical'
                    size_hint_x: None
                    width: "20dp"
                    height: "180dp"
                    pos_hint: {"center_y": 0.5}

                BoxLayout:
                    orientation: "vertical"
                    spacing: "8dp"
                    size_hint_x: 1
                    MDTextField:
                        id: entrada_acel
                        text:""
                        hint_text: "Aceleração (s)"
                        mode: "rectangle"
                        size_hint_y: None
                        height: "36dp"
                    MDTextField:
                        id: entrada_decel
                        text:""
                        hint_text: "Desaceleração (s)"
                        mode: "rectangle"
                        size_hint_y: None
                        height: "36dp"

            Label:
                text: f"Velocidade: {int(slider_velocidade.value)} Hz"
                halign: "center"
                color: 0,0,0
                size_hint_y: None
                height: "24dp"




